//输入一个n，输出1到n的所有排列方式
#include <stdio.h>
#include <stdbool.h> // 纯C语言使用bool类型必须加这个头文件

const int N = 10; // 假设n最大不超过10
int ans[N];       // ans数组：用来装我们排好的数字（比如装下1,2,3）
bool mark[N];     // mark数组：用来标记数字有没有被用过（true表示用过了，false表示还没用）
int n;            // 我们要排列的数字总数

// u 表示当前正在填第几个位置（从0开始数）
void dfs(int u)
{
    // 【1. 撞南墙的条件：递归出口】
    // 如果 u == n，说明 0 到 n-1 个位置都填满啦！
    if(u == n)
    {
        // 把填好的一组答案打印出来
        for(int i = 0; i < n; i++)
        {
            printf("%d ", ans[i]);
        }
        printf("\n");
        return; // 打印完必须回头！结束当前这层函数
    }
    
    // 【2. 站在岔路口：尝试每一种可能】
    // 当前位置 u，我们可以填 1 到 n 中的任意一个数字 i
    for(int i = 1; i <= n; i++)
    {
        // 【3. 判断这条路能不能走】
        // 如果数字 i 还没被前面的位置用过
        if(mark[i] == false)
        {
            // 【4. 标记现场 + 记录答案】
            mark[i] = true; // 把数字 i 标记为“已使用”
            ans[u] = i;     // 把数字 i 放进当前位置 u 的坑里
            
            // 【5. 继续往深处走！】
            // 当前位置填好了，去填下一个位置 (u + 1)
            dfs(u + 1); 
            
            // 【6. 恢复现场（核心！最易错点！）】
            // 为什么要有这一步？因为 dfs(u+1) 走完回来后，我们要尝试选下一个 i 了。
            // 如果不把 mark[i] 改回 false，数字 i 就被永远占用了，别人就没法用了。
            mark[i] = false; 
            ans[u] = 0;      // 把坑位清空（其实这一步可有可无，因为下次会覆盖，但写上逻辑更严密）
        }
    }
}

int main()
{
    scanf("%d", &n); // 输入 n
    dfs(0);          // 从第 0 个位置开始填
    return 0;
}